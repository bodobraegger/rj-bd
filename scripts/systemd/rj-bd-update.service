[Unit]
Description=Update rj-bd beach data from INEA (needs a Brazilian IP)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/personal/batheability-rio
ExecStartPre=/usr/bin/git pull --rebase --autostash --quiet origin main
ExecStart=%h/projects/personal/batheability-rio/scripts/update_data.sh --push
